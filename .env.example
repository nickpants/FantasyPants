# GridironAI local defaults. Copy to .env and adjust.
# On grok.me, put these in the Secrets store instead of a file. Never commit .env.

# Public process (scripts/start.mjs). Grok Build Web sets PORT for you.
PORT=3000
HOST=0.0.0.0

# Persistence. SQLite works out of the box. Swap to Postgres when Docker is up:
# DATABASE_URL=postgresql+asyncpg://gridiron:gridiron@localhost:5432/gridiron
DATABASE_URL=sqlite+aiosqlite:///./data/gridiron.db

# Optional. When unset, an in-process cache is used.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

SLEEPER_BASE_URL=https://api.sleeper.app/v1
RATE_LIMIT_PER_MINUTE=1000
NFLVERSE_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SpaceXAI (xAI) — server-side only. Create at https://console.x.ai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
