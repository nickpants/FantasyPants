{
  "name": "gridiron-ai",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": ["apps/web"],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run dev --prefix apps/web",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "cd apps/backend && ../../.venv/bin/uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "build": "npm run build --prefix apps/web",
    "start": "node scripts/start.mjs",
    "test:api": ".venv/bin/pytest"
  }
}
